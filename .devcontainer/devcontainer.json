{
  "name": "AI Test Automation Framework",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [8000, 8001, 5173],
  "portsAttributes": {
    "8000": {
      "label": "Web App & Backend",
      "onAutoForward": "openBrowser"
    },
    "8001": {
      "label": "Sample Target API",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Frontend Dev Server",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt && cd frontend && npm install && npm run build && cd ..",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
